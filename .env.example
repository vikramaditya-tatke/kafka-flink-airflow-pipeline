# Streaming settings. Astro reads this env file too; no credentials are required.
FLINK_UI_PORT=8081
KAFKA_HOST_PORT=29092
KAFKA_TOPIC=windows-events
EVENT_INTERVAL_MS=100
# Astro API port: ./scripts/astro.sh config set api-server.port 8082

# Generated into .env on first start when absent; never commit the real password.
# AIRBNB_CLICKHOUSE_PASSWORD=
# Optional: export temporary SSO credentials into an ignored local Airflow env file.
# AIRBNB_AWS_PROFILE=aws-personal-prod
# Or set AIRFLOW_CONN_AWS_AIRBNB to a JSON Airflow AWS connection in your environment.
