# Streaming settings. Astro reads this env file too; no credentials are required.
FLINK_UI_PORT=8081
KAFKA_HOST_PORT=29092
KAFKA_TOPIC=windows-events-v2
KAFKA_ALERT_TOPIC=windows-security-alerts-v2
KAFKA_QUARANTINE_TOPIC=windows-events-quarantine-v2
PIPELINE_STREAM_ID=windows-v2
KAFKA_WATCHER_INTERVAL=15
EVENT_INTERVAL_MS=100
# Astro API port: ./scripts/astro.sh config set api-server.port 8082
