{
  "verified_at": "2026-10-25T01:36:17.545168+00:00",
  "bucket": "airbnb-analytics-bucket-v2",
  "region": "eu-west-2",
  "public_access_block": {
    "BlockPublicAcls": true,
    "IgnorePublicAcls": true,
    "BlockPublicPolicy": true,
    "RestrictPublicBuckets": true
  },
  "ownership": {
